{
    "name": "danilovl/contact-bundle",
    "description": "Personal address book bundle for Symfony: contacts with multiple emails, phones, addresses, links, dates and relations, REST API, vCard import/export and Vue.js SPA.",
    "type": "symfony-bundle",
    "keywords": ["php","symfony","bundle","contacts","address-book","vcard"],
    "license": "MIT",
    "authors": [
        {
            "name": "Vladimir Danilov"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.0",
        "symfony/asset": "^8.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "suggest": {
        "symfony/security-bundle": "Personal address book per authenticated user"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.0.9",
        "phpunit/phpunit": "^12.0",
        "symfony/security-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Danilovl\\ContactBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danilovl\\ContactBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit tests/Unit",
        "phpstan": "phpstan analyse -c phpstan.neon src tests --no-progress",
        "phpstan-generate-baseline": "@php vendor/bin/phpstan analyse --level 9  --configuration phpstan.neon  src/ tests/ --generate-baseline",
        "cs-fixer": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs-fixer-check": "vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
